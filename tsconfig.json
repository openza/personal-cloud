{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types",
      "node",
      "vite/client"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "worker-env.d.ts"
  ]
}
